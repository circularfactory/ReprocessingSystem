                                    :ProcessSignalQuantity ;
                           <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Voltage> ;
                           rdfs:comment "The amplitude of the structure-borne sound signal of the acoustic emission system."@en ;
                           rdfs:label "Acoustic Emission Amplitude"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#BuildHeight
:BuildHeight rdf:type owl:NamedIndividual ,
                      :DepositCharacteristic ;
             <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
             rdfs:comment "The cumulative height of the deposited material above the substrate."@en ;
             rdfs:label "Build Height"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#CarrierGasFlowRate
:CarrierGasFlowRate rdf:type owl:NamedIndividual ,
                             :DepositionProcessParameter ;
                    <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/VolumeFlowRate> ;
                    rdfs:comment "The volume flow rate of the gas transporting the powder to the nozzle."@en ;
                    rdfs:label "Carrier Gas Flow Rate"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#CausticFocusPosition
:CausticFocusPosition rdf:type owl:NamedIndividual ,
                               :PowderCausticCharacteristic ;
                      <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
                      rdfs:comment "The axial distance of the powder stream waist from the nozzle tip."@en ;
                      rdfs:label "Caustic Focus Position"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#CausticOvality
:CausticOvality rdf:type owl:NamedIndividual ,
                         :PowderCausticCharacteristic ;
                <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Dimensionless> ;
                rdfs:comment "The second Fourier order of the powder caustic cross-section, used as an indicator of the condition of the powder nozzle."@en ;
                rdfs:label "Caustic Ovality"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#CausticWaistDiameter
:CausticWaistDiameter rdf:type owl:NamedIndividual ,
                               :PowderCausticCharacteristic ;
                      <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
                      rdfs:comment "The smallest diameter of the powder stream along its axis."@en ;
                      rdfs:label "Caustic Waist Diameter"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#CrossValidatedPredictionError
:CrossValidatedPredictionError rdf:type owl:NamedIndividual ,
                                        :UncertaintyEvaluationMethod ;
                               rdfs:comment "Uncertainty of a model-based prediction estimated from the cross-validated prediction error of the data-driven process model."@en ;
                               rdfs:label "Cross-Validated Prediction Error"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#CuttingSpeed
:CuttingSpeed rdf:type owl:NamedIndividual ,
                       :MachiningProcessParameter ;
              <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Velocity> ;
              rdfs:comment "The speed of the cutting edge relative to the workpiece."@en ;
              rdfs:label "Cutting Speed"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#DepthOfCut
:DepthOfCut rdf:type owl:NamedIndividual ,
                     :MachiningProcessParameter ;
            <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
            rdfs:comment "The thickness of material removed in one machining pass."@en ;
            rdfs:label "Depth of Cut"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#FeedRate
:FeedRate rdf:type owl:NamedIndividual ,
                   :MachiningProcessParameter ;
          <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Velocity> ;
          rdfs:comment "The feed velocity of the tool relative to the workpiece."@en ;
          rdfs:label "Feed Rate"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#GUMTypeAEvaluation
:GUMTypeAEvaluation rdf:type owl:NamedIndividual ,
                             :UncertaintyEvaluationMethod ;
                    rdfs:comment "Uncertainty evaluated by statistical analysis of a series of observations (JCGM 100:2008)."@en ;
                    rdfs:label "GUM Type A Evaluation"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#GUMTypeBEvaluation
:GUMTypeBEvaluation rdf:type owl:NamedIndividual ,
                             :UncertaintyEvaluationMethod ;
                    rdfs:comment "Uncertainty evaluated by means other than statistical analysis of observations, e.g. from manufacturer specifications or calibration certificates (JCGM 100:2008)."@en ;
                    rdfs:label "GUM Type B Evaluation"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#LaserPower
:LaserPower rdf:type owl:NamedIndividual ,
                     :DepositionProcessParameter ;
            <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Power> ;
            rdfs:comment "The nominal output power of the processing laser."@en ;
            rdfs:label "Laser Power"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#LaserSpotDiameter
:LaserSpotDiameter rdf:type owl:NamedIndividual ,
                            :DepositionProcessParameter ;
                   <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
                   rdfs:comment "The diameter of the laser beam on the substrate surface."@en ;
                   rdfs:label "Laser Spot Diameter"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#LayerHeight
:LayerHeight rdf:type owl:NamedIndividual ,
                      :DepositCharacteristic ;
             <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
             rdfs:comment "The height increment of one deposited layer, measured in-process by OCT or after deposition by laser line scanning."@en ;
             rdfs:label "Layer Height"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#MeltPoolTemperature
:MeltPoolTemperature rdf:type owl:NamedIndividual ,
                              :ProcessSignalQuantity ;
                     <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/ThermodynamicTemperature> ;
                     rdfs:comment "The temperature of the interaction zone as measured by two-colour pyrometry."@en ;
                     rdfs:label "Melt Pool Temperature"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#MeltPoolWidth
:MeltPoolWidth rdf:type owl:NamedIndividual ,
                        :ProcessSignalQuantity ;
               <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
               rdfs:comment "The width of the melt pool as derived from high-speed imaging."@en ;
               rdfs:label "Melt Pool Width"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#ParticleSizeD10
:ParticleSizeD10 rdf:type owl:NamedIndividual ,
                          :PowderCharacteristic ;
                 <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
                 rdfs:comment "The particle diameter below which 10 % of the powder volume lies."@en ;
                 rdfs:label "Particle Size D10"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#ParticleSizeD50
:ParticleSizeD50 rdf:type owl:NamedIndividual ,
                          :PowderCharacteristic ;
                 <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
                 rdfs:comment "The median particle diameter of the powder volume distribution."@en ;
                 rdfs:label "Particle Size D50"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#ParticleSizeD90
:ParticleSizeD90 rdf:type owl:NamedIndividual ,
                          :PowderCharacteristic ;
                 <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
                 rdfs:comment "The particle diameter below which 90 % of the powder volume lies."@en ;
                 rdfs:label "Particle Size D90"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#PowderMassFlowRate
:PowderMassFlowRate rdf:type owl:NamedIndividual ,
                             :DepositionProcessParameter ;
                    <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/MassFlowRate> ;
                    rdfs:comment "The mass of powder fed through the nozzle per unit time."@en ;
                    rdfs:label "Powder Mass Flow Rate"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#ProcessingSpeed
:ProcessingSpeed rdf:type owl:NamedIndividual ,
                          :DepositionProcessParameter ;
                 <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Velocity> ;
                 rdfs:comment "The relative speed between deposition head and substrate surface; in high-speed DED-LB/M typically tens of metres per minute."@en ;
                 rdfs:label "Processing Speed"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#RelativeDensity
:RelativeDensity rdf:type owl:NamedIndividual ,
                          :DepositCharacteristic ;
                 <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/DimensionlessRatio> ;
                 rdfs:comment "The ratio of the density of the deposited material to the density of the fully dense material. Reference measurements are provided by material characterisation (subproject B02); C02 provides model-based predictions."@en ;
                 rdfs:label "Relative Density"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#ShieldingGasFlowRate
:ShieldingGasFlowRate rdf:type owl:NamedIndividual ,
                               :DepositionProcessParameter ;
                      <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/VolumeFlowRate> ;
                      rdfs:comment "The volume flow rate of the inert gas shielding the interaction zone."@en ;
                      rdfs:label "Shielding Gas Flow Rate"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#SpectralLag
:SpectralLag rdf:type owl:NamedIndividual ,
                      :ProcessSignalQuantity ;
             <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Time> ;
             rdfs:comment "The time delay between a laser power step and the resulting emission response of the interaction zone."@en ;
             rdfs:label "Spectral Lag"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#SpindleSpeed
:SpindleSpeed rdf:type owl:NamedIndividual ,
                       :MachiningProcessParameter ;
              <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/RotationalFrequency> ;
              rdfs:comment "The rotational frequency of the machine spindle."@en ;
              rdfs:label "Spindle Speed"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#TrackOffset
:TrackOffset rdf:type owl:NamedIndividual ,
                      :DepositionProcessParameter ;
             <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
             rdfs:comment "The lateral distance between the centre lines of adjacent deposition tracks."@en ;
             rdfs:label "Track Offset"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#TrackWidth
:TrackWidth rdf:type owl:NamedIndividual ,
                     :DepositCharacteristic ;
            <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
            rdfs:comment "The width of a single deposited track."@en ;
            rdfs:label "Track Width"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#VickersHardness
:VickersHardness rdf:type owl:NamedIndividual ,
                          :DepositCharacteristic ;
                 rdfs:comment "The Vickers hardness of the deposited material. Reference measurements are provided by material characterisation (subproject B02); C02 provides model-based predictions. No QUDT quantity kind is assigned because hardness scales are not physical quantities in the sense of the SI."@en ;
                 rdfs:label "Vickers Hardness"@en .


###  http://w3id.org/circularfactory/ReprocessingSystem#WorkingDistance
:WorkingDistance rdf:type owl:NamedIndividual ,
                          :DepositionProcessParameter ;
                 <http://qudt.org/schema/qudt/hasQuantityKind> <http://qudt.org/vocab/quantitykind/Length> ;
                 rdfs:comment "The distance between nozzle tip and substrate surface."@en ;
                 rdfs:label "Working Distance"@en .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AcousticEmissionSystem
                :HighSpeedCamera
                :LaserLineScanner
                :OpticalCoherenceTomographySystem
                :OpticalEmissionSpectrometer
                :PowderCausticAnalysisSystem
                :TwoColourPyrometer
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AdditiveDepositionRun
                :MachiningRun
                :MonitoringRun
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :AdditiveSubtractiveReprocessingProcess
                :HighSpeedDEDProcess
                :SubtractiveMachiningProcess
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :ManufacturingResource
                :MeasurementSystem
                :PowderNozzle
                :SpecializedMachineCell
              )
] .


[ rdf:type owl:AllDifferent ;
  owl:distinctMembers ( :CrossValidatedPredictionError
                        :GUMTypeAEvaluation
                        :GUMTypeBEvaluation
                      )
] .


