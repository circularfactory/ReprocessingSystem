    <!-- http://w3id.org/circularfactory/ReprocessingSystem#AcousticEmissionAmplitude -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#AcousticEmissionAmplitude">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessSignalQuantity"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Voltage"/>
        <rdfs:comment xml:lang="en">The amplitude of the structure-borne sound signal of the acoustic emission system.</rdfs:comment>
        <rdfs:label xml:lang="en">Acoustic Emission Amplitude</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#BuildHeight -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#BuildHeight">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The cumulative height of the deposited material above the substrate.</rdfs:comment>
        <rdfs:label xml:lang="en">Build Height</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#CarrierGasFlowRate -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#CarrierGasFlowRate">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/VolumeFlowRate"/>
        <rdfs:comment xml:lang="en">The volume flow rate of the gas transporting the powder to the nozzle.</rdfs:comment>
        <rdfs:label xml:lang="en">Carrier Gas Flow Rate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#CausticFocusPosition -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#CausticFocusPosition">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The axial distance of the powder stream waist from the nozzle tip.</rdfs:comment>
        <rdfs:label xml:lang="en">Caustic Focus Position</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#CausticOvality -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#CausticOvality">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Dimensionless"/>
        <rdfs:comment xml:lang="en">The second Fourier order of the powder caustic cross-section, used as an indicator of the condition of the powder nozzle.</rdfs:comment>
        <rdfs:label xml:lang="en">Caustic Ovality</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#CausticWaistDiameter -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#CausticWaistDiameter">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The smallest diameter of the powder stream along its axis.</rdfs:comment>
        <rdfs:label xml:lang="en">Caustic Waist Diameter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#CrossValidatedPredictionError -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#CrossValidatedPredictionError">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#UncertaintyEvaluationMethod"/>
        <rdfs:comment xml:lang="en">Uncertainty of a model-based prediction estimated from the cross-validated prediction error of the data-driven process model.</rdfs:comment>
        <rdfs:label xml:lang="en">Cross-Validated Prediction Error</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#CuttingSpeed -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#CuttingSpeed">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MachiningProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Velocity"/>
        <rdfs:comment xml:lang="en">The speed of the cutting edge relative to the workpiece.</rdfs:comment>
        <rdfs:label xml:lang="en">Cutting Speed</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#DepthOfCut -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#DepthOfCut">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MachiningProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The thickness of material removed in one machining pass.</rdfs:comment>
        <rdfs:label xml:lang="en">Depth of Cut</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#FeedRate -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#FeedRate">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MachiningProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Velocity"/>
        <rdfs:comment xml:lang="en">The feed velocity of the tool relative to the workpiece.</rdfs:comment>
        <rdfs:label xml:lang="en">Feed Rate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#GUMTypeAEvaluation -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#GUMTypeAEvaluation">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#UncertaintyEvaluationMethod"/>
        <rdfs:comment xml:lang="en">Uncertainty evaluated by statistical analysis of a series of observations (JCGM 100:2008).</rdfs:comment>
        <rdfs:label xml:lang="en">GUM Type A Evaluation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#GUMTypeBEvaluation -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#GUMTypeBEvaluation">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#UncertaintyEvaluationMethod"/>
        <rdfs:comment xml:lang="en">Uncertainty evaluated by means other than statistical analysis of observations, e.g. from manufacturer specifications or calibration certificates (JCGM 100:2008).</rdfs:comment>
        <rdfs:label xml:lang="en">GUM Type B Evaluation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#LaserPower -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#LaserPower">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Power"/>
        <rdfs:comment xml:lang="en">The nominal output power of the processing laser.</rdfs:comment>
        <rdfs:label xml:lang="en">Laser Power</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#LaserSpotDiameter -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#LaserSpotDiameter">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The diameter of the laser beam on the substrate surface.</rdfs:comment>
        <rdfs:label xml:lang="en">Laser Spot Diameter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#LayerHeight -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#LayerHeight">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The height increment of one deposited layer, measured in-process by OCT or after deposition by laser line scanning.</rdfs:comment>
        <rdfs:label xml:lang="en">Layer Height</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MeltPoolTemperature -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MeltPoolTemperature">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessSignalQuantity"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"/>
        <rdfs:comment xml:lang="en">The temperature of the interaction zone as measured by two-colour pyrometry.</rdfs:comment>
        <rdfs:label xml:lang="en">Melt Pool Temperature</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MeltPoolWidth -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MeltPoolWidth">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessSignalQuantity"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The width of the melt pool as derived from high-speed imaging.</rdfs:comment>
        <rdfs:label xml:lang="en">Melt Pool Width</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ParticleSizeD10 -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ParticleSizeD10">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#PowderCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The particle diameter below which 10 % of the powder volume lies.</rdfs:comment>
        <rdfs:label xml:lang="en">Particle Size D10</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ParticleSizeD50 -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ParticleSizeD50">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#PowderCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The median particle diameter of the powder volume distribution.</rdfs:comment>
        <rdfs:label xml:lang="en">Particle Size D50</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ParticleSizeD90 -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ParticleSizeD90">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#PowderCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The particle diameter below which 90 % of the powder volume lies.</rdfs:comment>
        <rdfs:label xml:lang="en">Particle Size D90</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PowderMassFlowRate -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PowderMassFlowRate">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/MassFlowRate"/>
        <rdfs:comment xml:lang="en">The mass of powder fed through the nozzle per unit time.</rdfs:comment>
        <rdfs:label xml:lang="en">Powder Mass Flow Rate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ProcessingSpeed -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ProcessingSpeed">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Velocity"/>
        <rdfs:comment xml:lang="en">The relative speed between deposition head and substrate surface; in high-speed DED-LB/M typically tens of metres per minute.</rdfs:comment>
        <rdfs:label xml:lang="en">Processing Speed</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#RelativeDensity -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#RelativeDensity">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/DimensionlessRatio"/>
        <rdfs:comment xml:lang="en">The ratio of the density of the deposited material to the density of the fully dense material. Reference measurements are provided by material characterisation (subproject B02); C02 provides model-based predictions.</rdfs:comment>
        <rdfs:label xml:lang="en">Relative Density</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ShieldingGasFlowRate -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ShieldingGasFlowRate">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/VolumeFlowRate"/>
        <rdfs:comment xml:lang="en">The volume flow rate of the inert gas shielding the interaction zone.</rdfs:comment>
        <rdfs:label xml:lang="en">Shielding Gas Flow Rate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#SpectralLag -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#SpectralLag">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessSignalQuantity"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Time"/>
        <rdfs:comment xml:lang="en">The time delay between a laser power step and the resulting emission response of the interaction zone.</rdfs:comment>
        <rdfs:label xml:lang="en">Spectral Lag</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#SpindleSpeed -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#SpindleSpeed">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MachiningProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/RotationalFrequency"/>
        <rdfs:comment xml:lang="en">The rotational frequency of the machine spindle.</rdfs:comment>
        <rdfs:label xml:lang="en">Spindle Speed</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#TrackOffset -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#TrackOffset">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The lateral distance between the centre lines of adjacent deposition tracks.</rdfs:comment>
        <rdfs:label xml:lang="en">Track Offset</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#TrackWidth -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#TrackWidth">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositCharacteristic"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The width of a single deposited track.</rdfs:comment>
        <rdfs:label xml:lang="en">Track Width</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#VickersHardness -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#VickersHardness">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositCharacteristic"/>
        <rdfs:comment xml:lang="en">The Vickers hardness of the deposited material. Reference measurements are provided by material characterisation (subproject B02); C02 provides model-based predictions. No QUDT quantity kind is assigned because hardness scales are not physical quantities in the sense of the SI.</rdfs:comment>
        <rdfs:label xml:lang="en">Vickers Hardness</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#WorkingDistance -->


    <owl:NamedIndividual rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#WorkingDistance">
        <rdf:type rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter"/>
        <qudt:hasQuantityKind rdf:resource="http://qudt.org/vocab/quantitykind/Length"/>
        <rdfs:comment xml:lang="en">The distance between nozzle tip and substrate surface.</rdfs:comment>
        <rdfs:label xml:lang="en">Working Distance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#AcousticEmissionSystem"/>
            <rdf:Description rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedCamera"/>
            <rdf:Description rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#LaserLineScanner"/>
            <rdf:Description rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#OpticalCoherenceTomographySystem"/>
            <rdf:Description rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#OpticalEmissionSpectrometer"/>
            <rdf:Description rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticAnalysisSystem"/>
            <rdf:Description rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#TwoColourPyrometer"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
