    <owl:Class rdf:about="http://qudt.org/schema/qudt/QuantityValue"/>
    


    <!-- http://w3id.org/circularfactory/Core#AtomicTask -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#AtomicTask"/>
    


