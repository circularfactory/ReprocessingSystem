    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#Component"/>
    


    <!-- http://w3id.org/circularfactory/Core#CompositeTask -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#CompositeTask"/>
    


    <!-- http://w3id.org/circularfactory/Core#EquippedCapability -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#EquippedCapability"/>
    


    <!-- http://w3id.org/circularfactory/Core#Operation -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#Operation"/>
    


    <!-- http://w3id.org/circularfactory/Core#QualityState -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#QualityState"/>
    


    <!-- http://w3id.org/circularfactory/Core#Resource -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#Resource"/>
    


    <!-- http://w3id.org/circularfactory/Core#SupportingProcess -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#SupportingProcess"/>
    


    <!-- http://w3id.org/circularfactory/Core#UnitPreservingProcess -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#UnitPreservingProcess"/>
    


    <!-- http://w3id.org/circularfactory/Core#VirginMaterial -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#VirginMaterial"/>
    


    <!-- http://w3id.org/circularfactory/Core#Workpiece -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/Core#Workpiece"/>
    


    <!-- http://w3id.org/circularfactory/PerpetualProduct#ManufacturingHistory -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/PerpetualProduct#ManufacturingHistory"/>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#AcousticEmissionRecording -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#AcousticEmissionRecording">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringDataset"/>
        <rdfs:comment xml:lang="en">A structure-borne sound recording of an acoustic emission system.</rdfs:comment>
        <rdfs:label xml:lang="en">Acoustic Emission Recording</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#AcousticEmissionSystem -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#AcousticEmissionSystem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem"/>
        <rdfs:comment xml:lang="en">A structure-borne sound sensor system (e.g. QASS). It is the only measurement system used in both deposition and machining and is remounted between the two machines.</rdfs:comment>
        <rdfs:label xml:lang="en">Acoustic Emission System</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#AdditiveDepositionRun -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#AdditiveDepositionRun">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessRun"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/Core#implementsProcess"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedDEDProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A process run in which material is deposited by high-speed DED-LB/M.</rdfs:comment>
        <rdfs:label xml:lang="en">Additive Deposition Run</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#AdditiveSubtractiveReprocessingProcess -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#AdditiveSubtractiveReprocessingProcess">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#UnitPreservingProcess"/>
        <rdfs:comment xml:lang="en">A production process that restores a damaged component by removing the damaged volume, rebuilding it by high-speed DED-LB/M and finish machining the functional surfaces. One component enters and one component leaves the process.</rdfs:comment>
        <rdfs:label xml:lang="en">Additive-Subtractive Reprocessing Process</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#DamageRemovalMachiningProcess -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#DamageRemovalMachiningProcess">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#SubtractiveMachiningProcess"/>
        <rdfs:comment xml:lang="en">Machining that removes the damaged or affected volume of a component before additive build-up, based on inspection information on damage location and type.</rdfs:comment>
        <rdfs:label xml:lang="en">Damage Removal Machining Process</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#DataDrivenProcessModel -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#DataDrivenProcessModel">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#Sensor"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A statistical or machine-learning model that predicts deposit characteristics from process parameters and process monitoring features. Modelled as a virtual sensor in the sense of SOSA.</rdfs:comment>
        <rdfs:label xml:lang="en">Data-Driven Process Model</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#DepositCharacteristic -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#DepositCharacteristic">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">An observable property of deposited material, e.g. layer height, track width or relative density.</rdfs:comment>
        <rdfs:label xml:lang="en">Deposit Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#DepositQualityState -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#DepositQualityState">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#QualityState"/>
        <rdfs:comment xml:lang="en">The quality state of a workpiece after deposition, evaluated at a given time and supported by observations of deposit characteristics.</rdfs:comment>
        <rdfs:label xml:lang="en">Deposit Quality State</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#DepositedLayer -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#DepositedLayer">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="en">A layer of material deposited onto a workpiece during one additive deposition run. Characteristics such as layer height or relative density are observed on it.</rdfs:comment>
        <rdfs:label xml:lang="en">Deposited Layer</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#DepositionProcessParameter">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessParameter"/>
        <rdfs:comment xml:lang="en">A process parameter of high-speed DED-LB/M, e.g. laser power, processing speed or powder mass flow rate.</rdfs:comment>
        <rdfs:label xml:lang="en">Deposition Process Parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#EmissionSpectrumLog -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#EmissionSpectrumLog">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringDataset"/>
        <rdfs:comment xml:lang="en">A time-resolved log of emission spectra recorded by an optical emission spectrometer.</rdfs:comment>
        <rdfs:label xml:lang="en">Emission Spectrum Log</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#FeatureExtractionProcedure -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#FeatureExtractionProcedure">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Procedure"/>
        <rdfs:comment xml:lang="en">A documented signal or image processing procedure that derives a characteristic value from raw sensor data, e.g. the evaluation of the second Fourier order of the caustic cross-section.</rdfs:comment>
        <rdfs:label xml:lang="en">Feature Extraction Procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#FinishMachiningProcess -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#FinishMachiningProcess">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#SubtractiveMachiningProcess"/>
        <rdfs:comment xml:lang="en">Machining after additive build-up that restores the geometry and surface of the functional surfaces.</rdfs:comment>
        <rdfs:label xml:lang="en">Finish Machining Process</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#FullReprocessingCapability -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#FullReprocessingCapability">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#EquippedCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/Core#enablesProcess"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#AdditiveSubtractiveReprocessingProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The capability of the specialized machine cell to reprocess a damaged component by damage removal, high-speed DED-LB/M build-up and finish machining.</rdfs:comment>
        <rdfs:label xml:lang="en">Full Reprocessing Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedCamera -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedCamera">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem"/>
        <rdfs:comment xml:lang="en">A camera for high-speed imaging of the melt pool and the powder-laser interaction.</rdfs:comment>
        <rdfs:label xml:lang="en">High-Speed Camera</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedDEDCapability -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedDEDCapability">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#EquippedCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/Core#enablesProcess"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedDEDProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The capability of a high-speed DED machine to deposit material by HS DED-LB/M.</rdfs:comment>
        <rdfs:label xml:lang="en">High-Speed DED Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedDEDMachine -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedDEDMachine">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ManufacturingResource"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <rdfs:comment xml:lang="en">A machine for high-speed directed energy deposition with laser beam and metal powder (HS DED-LB/M, EHLA), e.g. the 5-axis pE3D system of ponticon GmbH in the InRePro cell.</rdfs:comment>
        <rdfs:label xml:lang="en">High-Speed DED Machine</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedDEDProcess -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedDEDProcess">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#UnitPreservingProcess"/>
        <rdfs:comment xml:lang="en">High-speed directed energy deposition with laser beam and metal powder (HS DED-LB/M, EHLA), in which the powder focus lies above the melt pool so that the powder is largely molten before it reaches the substrate.</rdfs:comment>
        <rdfs:label xml:lang="en">High-Speed DED Process</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedVideoRecording -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#HighSpeedVideoRecording">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringDataset"/>
        <rdfs:comment xml:lang="en">An image sequence recorded by a high-speed camera.</rdfs:comment>
        <rdfs:label xml:lang="en">High-Speed Video Recording</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#LaserLineScanProfile -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#LaserLineScanProfile">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringDataset"/>
        <rdfs:comment xml:lang="en">A set of surface profiles recorded by a laser line scanner.</rdfs:comment>
        <rdfs:label xml:lang="en">Laser Line Scan Profile</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#LaserLineScanner -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#LaserLineScanner">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem"/>
        <rdfs:comment xml:lang="en">A laser triangulation sensor that captures the surface profile of deposited tracks and layers.</rdfs:comment>
        <rdfs:label xml:lang="en">Laser Line Scanner</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MachiningProcessParameter -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MachiningProcessParameter">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessParameter"/>
        <rdfs:comment xml:lang="en">A process parameter of milling or turning, e.g. cutting speed or depth of cut.</rdfs:comment>
        <rdfs:label xml:lang="en">Machining Process Parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MachiningRun -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MachiningRun">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessRun"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/Core#implementsProcess"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#SubtractiveMachiningProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A process run in which material is removed by milling or turning.</rdfs:comment>
        <rdfs:label xml:lang="en">Machining Run</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ManufacturingResource -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ManufacturingResource">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#Resource"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:comment xml:lang="en">A machine of the reprocessing cell that changes the geometry or material state of a workpiece and hosts measurement systems.</rdfs:comment>
        <rdfs:label xml:lang="en">Manufacturing Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MaterialRemovalCapability -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MaterialRemovalCapability">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#EquippedCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/Core#enablesProcess"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#SubtractiveMachiningProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The capability of the specialized machine cell to perform machining only, without additive build-up.</rdfs:comment>
        <rdfs:label xml:lang="en">Material Removal Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#Measurement -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#Measurement">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Result"/>
        <rdfs:comment xml:lang="en">Data produced by a measurement observation.</rdfs:comment>
        <rdfs:label xml:lang="en">Measurement result</rdfs:label>
        <skos:editorialNote xml:lang="en">OPEN ISSUE OI-1: local class recommended by INF while it is open whether a measurement class is added to the Core. OPEN ISSUE OI-2: whether quantity-value results of observations shall additionally be typed as rps:Measurement is to be decided together with the uncertainty alignment with B03 and A03.</skos:editorialNote>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#Resource"/>
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#Sensor"/>
        <rdfs:comment xml:lang="en">A physical measurement system of the reprocessing cell that observes the process, the powder stream or the workpiece. Portable systems may be moved between manufacturing resources.</rdfs:comment>
        <rdfs:label xml:lang="en">Measurement System</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MeltPool -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MeltPool">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="en">The liquid metal region of the interaction zone during deposition, observed by pyrometry, high-speed imaging and emission spectroscopy.</rdfs:comment>
        <rdfs:label xml:lang="en">Melt Pool</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MetalPowderFeedstock -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MetalPowderFeedstock">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#VirginMaterial"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="en">A batch of metal powder used as filler material in high-speed DED-LB/M, characterised among others by its particle size distribution.</rdfs:comment>
        <rdfs:label xml:lang="en">Metal Powder Feedstock</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MillTurnMachiningCapability -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MillTurnMachiningCapability">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#EquippedCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/Core#enablesProcess"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#SubtractiveMachiningProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The capability of a mill-turn machining centre to remove material by milling and turning.</rdfs:comment>
        <rdfs:label xml:lang="en">Mill-Turn Machining Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MillTurnMachiningCentre -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MillTurnMachiningCentre">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ManufacturingResource"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <rdfs:comment xml:lang="en">A machine tool for milling and turning used for damage removal before and finish machining after deposition, e.g. the 5-axis DMU 60 eVo of DMG MORI in the InRePro cell.</rdfs:comment>
        <rdfs:label xml:lang="en">Mill-Turn Machining Centre</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ModelBasedPrediction -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ModelBasedPrediction">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/madeBySensor"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DataDrivenProcessModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An estimate of an observable property made by a data-driven process model (virtual sensor) from process parameter settings and process monitoring observations. The result carries the prediction uncertainty.</rdfs:comment>
        <rdfs:label xml:lang="en">Model-Based Prediction</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MonitoringRun -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MonitoringRun">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessRun"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/Core#implementsProcess"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MultisensoryProcessMonitoringProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A process run in which a measurement system records data during or before a deposition or machining run.</rdfs:comment>
        <rdfs:label xml:lang="en">Monitoring Run</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#MultisensoryProcessMonitoringProcess -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#MultisensoryProcessMonitoringProcess">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#SupportingProcess"/>
        <rdfs:comment xml:lang="en">A supporting process in which one or more measurement systems observe a deposition or machining process without changing the workpiece.</rdfs:comment>
        <rdfs:label xml:lang="en">Multisensory Process Monitoring Process</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#OCTMeasurementSeries -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#OCTMeasurementSeries">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringDataset"/>
        <rdfs:comment xml:lang="en">A series of distance measurements recorded by an optical coherence tomography system.</rdfs:comment>
        <rdfs:label xml:lang="en">OCT Measurement Series</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#OpticalCoherenceTomographySystem -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#OpticalCoherenceTomographySystem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem"/>
        <rdfs:comment xml:lang="en">An inline interferometric distance measurement system (e.g. Precitec IDM1550) used for in-process measurement of layer height in high-speed DED-LB/M.</rdfs:comment>
        <rdfs:label xml:lang="en">Optical Coherence Tomography System</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#OpticalEmissionSpectrometer -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#OpticalEmissionSpectrometer">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem"/>
        <rdfs:comment xml:lang="en">A spectrometer for synchronised multispectral emission analysis of the interaction zone, used among others to determine the spectral lag.</rdfs:comment>
        <rdfs:label xml:lang="en">Optical Emission Spectrometer</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PartialLeastSquaresRegressionModel -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PartialLeastSquaresRegressionModel">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DataDrivenProcessModel"/>
        <rdfs:comment xml:lang="en">A data-driven process model based on partial least squares (PLS) regression.</rdfs:comment>
        <rdfs:label xml:lang="en">Partial Least Squares Regression Model</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticAnalysisProcess -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticAnalysisProcess">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MultisensoryProcessMonitoringProcess"/>
        <rdfs:comment xml:lang="en">A supporting process that characterises the powder caustic before deposition in order to assess the condition of the powder nozzle.</rdfs:comment>
        <rdfs:label xml:lang="en">Powder Caustic Analysis Process</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticAnalysisSystem -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticAnalysisSystem">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem"/>
        <rdfs:comment xml:lang="en">A light-section system (e.g. ponticon PowderSpy) that images cross-sections of the powder stream to characterise the powder caustic and the nozzle condition.</rdfs:comment>
        <rdfs:label xml:lang="en">Powder Caustic Analysis System</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticCharacteristic -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticCharacteristic">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">An observable property of the powder stream that indicates the condition of the powder nozzle, e.g. caustic waist diameter or caustic ovality.</rdfs:comment>
        <rdfs:label xml:lang="en">Powder Caustic Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticImageStack -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PowderCausticImageStack">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringDataset"/>
        <rdfs:comment xml:lang="en">A stack of powder stream cross-section images recorded by a powder caustic analysis system.</rdfs:comment>
        <rdfs:label xml:lang="en">Powder Caustic Image Stack</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PowderCharacteristic -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PowderCharacteristic">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">An observable property of the metal powder feedstock, e.g. a characteristic value of the particle size distribution.</rdfs:comment>
        <rdfs:label xml:lang="en">Powder Characteristic</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PowderNozzle -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PowderNozzle">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#Resource"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="en">A coaxial powder nozzle of a high-speed DED machine. Its abrasive wear changes the powder caustic and is assessed by powder caustic analysis before deposition.</rdfs:comment>
        <rdfs:label xml:lang="en">Powder Nozzle</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PowderStream -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PowderStream">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="en">The powder-gas jet leaving the powder nozzle, whose caustic (waist diameter, focus position, cross-section shape) is observed by powder caustic analysis.</rdfs:comment>
        <rdfs:label xml:lang="en">Powder Stream</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringCapability -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringCapability">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#EquippedCapability"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/Core#enablesProcess"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MultisensoryProcessMonitoringProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The capability of a measurement system to observe a deposition or machining process.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Monitoring Capability</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringDataset -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringDataset">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#Measurement"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A raw data artifact recorded by a measurement system during a process run. Only the storage location of the raw data is kept in the knowledge graph. Replaces the middleware term &apos;Dataset&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Monitoring Dataset</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringObservation -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringObservation">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/madeBySensor"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An observation made by a physical measurement system of the reprocessing cell. The result is given as qudt:QuantityValue, optionally with its measurement uncertainty.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Monitoring Observation</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ProcessParameter -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ProcessParameter">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ActuatableProperty"/>
        <rdfs:comment xml:lang="en">A controllable property of a manufacturing process that is set by the machine control.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ProcessParameterSetting -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ProcessParameterSetting">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/actsOnProperty"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/sosa/madeByActuator"/>
                <owl:allValuesFrom rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ManufacturingResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The setting of one process parameter to a nominal value by a manufacturing resource during a process run. The nominal value is given as qudt:QuantityValue via sosa:hasResult. Settings are individuals so that they can later serve as causes in causal relations.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Parameter Setting</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ProcessRun -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ProcessRun">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#AtomicTask"/>
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#Operation"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">An executed, indivisible step of a reprocessing operation on one resource of the cell, for example one deposition run, one machining run or one monitoring run.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Run</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ProcessSignalQuantity -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ProcessSignalQuantity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <rdfs:comment xml:lang="en">An observable property of the running process itself, e.g. melt pool temperature, spectral lag or acoustic emission amplitude.</rdfs:comment>
        <rdfs:label xml:lang="en">Process Signal Quantity</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#PyrometryTimeSeries -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#PyrometryTimeSeries">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#ProcessMonitoringDataset"/>
        <rdfs:comment xml:lang="en">A temperature time series recorded by a two-colour pyrometer.</rdfs:comment>
        <rdfs:label xml:lang="en">Pyrometry Time Series</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ReprocessedComponent -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ReprocessedComponent">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#Component"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <rdfs:comment xml:lang="en">A component that is or was subject to a reprocessing operation. The component identity is managed by production control; this class adds the C02 view on it.</rdfs:comment>
        <rdfs:label xml:lang="en">Reprocessed Component</rdfs:label>
        <skos:editorialNote xml:lang="en">OPEN ISSUE OI-3: unsatisfiable under Core 0.9.0 because cfc:Component is unsatisfiable there; correction pending in the Core.</skos:editorialNote>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ReprocessingHistory -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ReprocessingHistory">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/PerpetualProduct#ManufacturingHistory"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">The part of the manufacturing history of a component that documents the reprocessing operations it has undergone in the specialized machine cell.</rdfs:comment>
        <rdfs:label xml:lang="en">Reprocessing History</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ReprocessingOperation -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ReprocessingOperation">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#CompositeTask"/>
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#Operation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#reprocessesComponent"/>
                <owl:someValuesFrom rdf:resource="http://w3id.org/circularfactory/Core#Workpiece"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://w3id.org/circularfactory/Core#implementsProcess"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#AdditiveSubtractiveReprocessingProcess"/>
                            <rdf:Description rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#SubtractiveMachiningProcess"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An operation dispatched by production control to the specialized machine cell to reprocess one component. Its IRI serves as correlation key between production control and subproject C02; it is decomposed into process runs.</rdfs:comment>
        <rdfs:label xml:lang="en">Reprocessing Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#ResponseSurfaceModel -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#ResponseSurfaceModel">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#DataDrivenProcessModel"/>
        <rdfs:comment xml:lang="en">An empirical regression model derived from a design of experiments, e.g. a central composite design.</rdfs:comment>
        <rdfs:label xml:lang="en">Response Surface Model</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#Sensor -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#Sensor">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">Any physical or virtual device, agent or software that observes a property in the C02 reprocessing context.</rdfs:comment>
        <rdfs:label xml:lang="en">Sensor</rdfs:label>
        <skos:editorialNote xml:lang="en">OPEN ISSUE OI-1: local class recommended by INF while it is open whether a sensor class is added to the Core.</skos:editorialNote>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#SpecializedMachineCell -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#SpecializedMachineCell">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#Resource"/>
        <rdfs:comment xml:lang="en">The InRePro reprocessing cell of subproject C02 as the single externally addressed resource of the circular factory. It receives reprocessing operations from production control and decides internally on the sequence of process runs and the measurement systems involved. Replaces the middleware term &apos;SpecializedMachines&apos; (singular noun required by the SFB modeling convention).</rdfs:comment>
        <rdfs:label xml:lang="en">Specialized Machine Cell</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#SubtractiveMachiningProcess -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#SubtractiveMachiningProcess">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/Core#UnitPreservingProcess"/>
        <rdfs:comment xml:lang="en">A production process that removes material from a component by milling or turning.</rdfs:comment>
        <rdfs:label xml:lang="en">Subtractive Machining Process</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#TwoColourPyrometer -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#TwoColourPyrometer">
        <rdfs:subClassOf rdf:resource="http://w3id.org/circularfactory/ReprocessingSystem#MeasurementSystem"/>
        <rdfs:comment xml:lang="en">A coaxial ratio pyrometer measuring the temperature of the interaction zone largely independently of emissivity.</rdfs:comment>
        <rdfs:label xml:lang="en">Two-Colour Pyrometer</rdfs:label>
    </owl:Class>
    


    <!-- http://w3id.org/circularfactory/ReprocessingSystem#UncertaintyEvaluationMethod -->


    <owl:Class rdf:about="http://w3id.org/circularfactory/ReprocessingSystem#UncertaintyEvaluationMethod">
        <rdfs:comment xml:lang="en">The method by which the uncertainty stated for a quantity value was obtained.</rdfs:comment>
        <rdfs:label xml:lang="en">Uncertainty Evaluation Method</rdfs:label>
        <skos:editorialNote xml:lang="en">OPEN ISSUE OI-2: to be aligned with the uncertainty models of B03 and A03.</skos:editorialNote>
    </owl:Class>
    


